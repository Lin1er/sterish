{
  "spec": "sterish-content-hash/v1",
  "spec_doc": "docs/specs/content-hash.md",
  "magic_hex": "737465726973682d636f6e74656e742d686173682f76310a",
  "note": "content_b64 = base64 standar dari byte MENTAH file (sebelum normalisasi). expected_sha256 = 64 hex huruf kecil, dihasilkan oleh docs/specs/reference/content_hash.py --regen dan diverifikasi identik oleh implementasi TypeScript dan Rust lewat scripts/verify-content-hash.sh.",
  "vectors": [
    {
      "id": "single-file",
      "description": "Satu file SKILL.md ASCII. Jalur paling dasar: MAGIC || u32be(1) || entry.",
      "files_note": "1 file yang ikut di-hash: SKILL.md",
      "files": [
        {
          "path": "SKILL.md",
          "content_b64": "IyBFeGFtcGxlIFNraWxsCgpEb2VzIG5vdGhpbmcgaGFybWZ1bC4KRW5kLgo="
        }
      ],
      "expected_sha256": "eaaad94080f641183a4caa2c03e9ccea36c2d466d446909b5b55e0824d3d9edd"
    },
    {
      "id": "poisoned-token-drainer",
      "description": "manifest.json asli dari pipeline/tests/poisoned_skill/ (disalin ke docs/specs/vectors/fixtures/poisoned_skill/). Mengikat spec ke korpus nyata.",
      "files_note": "1 file yang ikut di-hash: manifest.json (fixture apa adanya, trailing newline dinormalisasi hilang)",
      "source_fixture": "docs/specs/vectors/fixtures/poisoned_skill",
      "files": [
        {
          "path": "manifest.json",
          "content_b64": ""
        }
      ],
      "expected_sha256": "c2bd4a316415b4919e3f1f40d9925f4052d020cf3dc2ecabe0e7c9dd28cc87f0"
    },
    {
      "id": "multi-file-ordering",
      "description": "3 file dengan urutan sisip != urutan terurut, ada path bersarang dan isi non-ASCII. Membuktikan sort bytewise + length-prefix.",
      "files_note": "3 file yang ikut di-hash: tools/zeta.py, SKILL.md, assets/data.json. Urutan kanonik = SKILL.md (0x53) < assets/data.json (0x61) < tools/zeta.py (0x74).",
      "files": [
        {
          "path": "tools/zeta.py",
          "content_b64": "IyB6ZXRhCnByaW50KCLOtiIpCg=="
        },
        {
          "path": "SKILL.md",
          "content_b64": "IyBNdWx0aQoKQmVyaXNpIGthcmFrdGVyIG5vbi1BU0NJSTogY2Fmw6ksIOaXpeacrOiqniwg8J+agAo="
        },
        {
          "path": "assets/data.json",
          "content_b64": "eyJrIjogInbDpGx1ZSJ9Cg=="
        }
      ],
      "expected_sha256": "e650ee53b67bf159ff2d64a444d52ed6e76d7f6f6c79869a20864cd8b6c2ade6"
    },
    {
      "id": "non-bmp-path-order",
      "description": "Dua path: U+FF21 (FULLWIDTH A, UTF-8 EF BC A1) dan U+1F600 (emoji, UTF-8 F0 9F 98 80). Urutan bytewise UTF-8 menaruh fullwidth DULU; Array.prototype.sort() JS (UTF-16 code unit, surrogate 0xD83D) menaruh emoji dulu. Vector ini gagal kalau ada implementasi yang salah sort.",
      "files_note": "2 file yang ikut di-hash: 😀.md lalu Ａ.md (urutan kanonik: Ａ.md dulu)",
      "files": [
        {
          "path": "😀.md",
          "content_b64": "ZW1vamkK"
        },
        {
          "path": "Ａ.md",
          "content_b64": "ZnVsbHdpZHRoCg=="
        }
      ],
      "expected_sha256": "3b0f76b5277c35d985428b0603df31b174f04b116a35b511eb47129b6cf78248"
    },
    {
      "id": "crlf-equals-lf",
      "description": "Isi logis sama dengan single-file tapi memakai CRLF, satu CR telanjang, dan 3 newline di akhir. Hash WAJIB sama dengan single-file.",
      "files_note": "1 file yang ikut di-hash: SKILL.md",
      "files": [
        {
          "path": "SKILL.md",
          "content_b64": "IyBFeGFtcGxlIFNraWxsDQoNCkRvZXMgbm90aGluZyBoYXJtZnVsLg1FbmQuDQoNCg0K"
        }
      ],
      "expected_sha256": "eaaad94080f641183a4caa2c03e9ccea36c2d466d446909b5b55e0824d3d9edd",
      "expect_equal_to": [
        "single-file"
      ]
    },
    {
      "id": "one-byte-flip",
      "description": "single-file dengan 1 byte berubah (0x6c 'l' -> 0x4c 'L' pada kata 'harmful'). Hash WAJIB berbeda dari single-file.",
      "files_note": "1 file yang ikut di-hash: SKILL.md",
      "files": [
        {
          "path": "SKILL.md",
          "content_b64": "IyBFeGFtcGxlIFNraWxsCgpEb2VzIG5vdGhpbmcgaGFybWZ1TC4KRW5kLgo="
        }
      ],
      "expected_sha256": "dcf8d82be686c3cf845e7e7d69300683480d6cb45497816a0dcd5afd4f89732b",
      "expect_differs_from": [
        "single-file"
      ]
    },
    {
      "id": "concat-ambiguity-a",
      "description": "Pasangan (path='a', content='bc'). Tanpa length-prefix, konkatenasi mentahnya identik dengan concat-ambiguity-b.",
      "files_note": "1 file yang ikut di-hash: a",
      "files": [
        {
          "path": "a",
          "content_b64": "YmM="
        }
      ],
      "expected_sha256": "9e858aa54369f35e3c42d8ba46462943486c497bf9fa08438c55cc760dec5ae3",
      "expect_differs_from": [
        "concat-ambiguity-b"
      ]
    },
    {
      "id": "concat-ambiguity-b",
      "description": "Pasangan (path='ab', content='c'). Hash WAJIB berbeda dari concat-ambiguity-a; itulah gunanya u32be length-prefix.",
      "files_note": "1 file yang ikut di-hash: ab",
      "files": [
        {
          "path": "ab",
          "content_b64": "Yw=="
        }
      ],
      "expected_sha256": "666e8c6ece8f6e3aeb2c4e13f9f36c9ccec5517e2a53450ebeb9a5940875de8e",
      "expect_differs_from": [
        "concat-ambiguity-a"
      ]
    }
  ],
  "error_cases": [
    {
      "id": "err-empty-set",
      "description": "Set file kosong.",
      "files": [],
      "expect_error": "EmptyFileSet"
    },
    {
      "id": "err-duplicate-path",
      "description": "Path yang sama muncul dua kali.",
      "files": [
        {
          "path": "SKILL.md",
          "content_b64": "YQo="
        },
        {
          "path": "SKILL.md",
          "content_b64": "Ygo="
        }
      ],
      "expect_error": "DuplicatePath"
    },
    {
      "id": "err-not-utf8",
      "description": "Isi file bukan UTF-8 valid (0xFF 0xFE). v1 hanya mendukung skill berbasis teks.",
      "files": [
        {
          "path": "blob.bin",
          "content_b64": "//4AAQ=="
        }
      ],
      "expect_error": "NotUtf8"
    },
    {
      "id": "err-absolute-path",
      "description": "Path absolut (diawali '/').",
      "files": [
        {
          "path": "/SKILL.md",
          "content_b64": "eAo="
        }
      ],
      "expect_error": "InvalidPath"
    },
    {
      "id": "err-dot-prefix",
      "description": "Path diawali './'.",
      "files": [
        {
          "path": "./SKILL.md",
          "content_b64": "eAo="
        }
      ],
      "expect_error": "InvalidPath"
    },
    {
      "id": "err-dotdot",
      "description": "Path mengandung komponen '..'.",
      "files": [
        {
          "path": "../SKILL.md",
          "content_b64": "eAo="
        }
      ],
      "expect_error": "InvalidPath"
    },
    {
      "id": "err-empty-path",
      "description": "Path kosong.",
      "files": [
        {
          "path": "",
          "content_b64": "eAo="
        }
      ],
      "expect_error": "InvalidPath"
    },
    {
      "id": "err-backslash-separator",
      "description": "Backslash sebagai separator (path gaya Windows) ditolak; separator wajib POSIX '/'.",
      "files": [
        {
          "path": "tools\\zeta.py",
          "content_b64": "eAo="
        }
      ],
      "expect_error": "InvalidPath"
    },
    {
      "id": "err-double-slash",
      "description": "Komponen path kosong akibat '//'.",
      "files": [
        {
          "path": "tools//zeta.py",
          "content_b64": "eAo="
        }
      ],
      "expect_error": "InvalidPath"
    }
  ]
}
