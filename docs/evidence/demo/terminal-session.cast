[61.73643, "o", "\r\n2. paid request          -> 200\r\n"]
[61.736589, "o", "   licence   minted\r\n   mint tx   1aa1dff32396e353f36bbc03a0ddb5d1f947bbb478d5bc23e2ab2f1517f2e22a\r\n"]
