[17.895328, "o", "\u001b[1;39m{\u001b[0m\r\n  \u001b[1;34m\"verdict\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"SAFE\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n  \u001b[1;34m\"score\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;39m100\u001b[0m\u001b[1;39m,\u001b[0m\r\n  \u001b[1;34m\"risk\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"none\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n  \u001b[1;34m\"recommendation\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"ALLOW\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n  \u001b[1;34m\"evidence_hash\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"0e32f595ab4a5e7ba3138bcece81eaeed30ce42a2e1851a479de1ffb5a5792ed\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n  \u001b[1;34m\"finding\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"Synthesis: SAFE at score 100/100. no injection findings and score 100 >= safe threshold 70 -> SAFE (policy row 7)\"\u001b[0m\r\n\u001b[1;39m}\u001b[0m\r\n"]
