# Sterish backend deployment (STE-25).
# Copy to .env next to docker-compose.yml. NEVER commit a real .env.
#
#   docker compose --env-file .env up -d --build

# --- required ---------------------------------------------------------------
# Contracts from docs/deployments.md.
REGISTRY_CONTRACT_ID=C...
TOKENS_CONTRACT_ID=C...
# Public hostname Caddy serves and obtains a certificate for.
# Use :80 for a local run — Caddy then serves plain HTTP and skips ACME.
STERISH_DOMAIN=sterish.example.com
# Optional ACME contact: add `tls you@example.com` inside the Caddyfile site block.

# --- network ----------------------------------------------------------------
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# --- serving ----------------------------------------------------------------
INDEXER_ENABLED=1
RATE_LIMIT_PER_MINUTE=100
# Public base URL for report_uri. Leave empty until reports are actually served,
# so a client is never handed a link that 404s.
REPORT_BASE_URL=

# --- x402 paid path ---------------------------------------------------------
# Leave OZ_API_KEY empty to run reads only: /check and /skills keep working and
# existing licence holders are still served; only new purchases are unavailable,
# and /health reports facilitator_reachable false.
#   curl https://channels.openzeppelin.com/testnet/gen   (testnet needs no auth)
X402_FACILITATOR_URL=https://channels.openzeppelin.com/x402/testnet
OZ_API_KEY=
# Classic G... account that RECEIVES USDC (needs a USDC trustline). Not the SAC.
X402_PAY_TO=G...
USDC_SAC_ADDRESS=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
X402_PRICE_BASE_UNITS=1000000
# Signs mint_license; must hold the tokens contract's minter role.
MINTER_SECRET=S...

# --- demo buyer (STE-43) ----------------------------------------------------
# Lets the dashboard run a real x402 purchase with a server-side demo signer.
# Off unless both are set. The treasury is a TESTNET account holding USDC + XLM
# and nothing else: each purchase funds a fresh agent with exactly the price.
DEMO_BUYER_ENABLED=0
DEMO_TREASURY_SECRET=
DEMO_DAILY_LIMIT=50
DEMO_PER_CLIENT_PER_HOUR=5
USDC_CLASSIC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
HORIZON_URL=https://horizon-testnet.stellar.org

# --- artifacts --------------------------------------------------------------
# Host directory holding <skill_id>/<version>/ trees. Mounted read-only; the API
# re-hashes the bytes against the chain before serving them.
STERISH_ARTIFACTS_DIR=./artifacts

# --- ports (override when 80/443 are taken) ---------------------------------
HTTP_PORT=80
HTTPS_PORT=443
