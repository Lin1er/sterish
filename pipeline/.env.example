# Sterish audit pipeline — example configuration.
# Copy to .env and fill in. NEVER commit a real .env (see .gitignore).
#
# The names below are the ones the code and scripts/ actually read, and match
# docs/deployments.md. An earlier version of this file documented invented names
# (REGISTRY_CONTRACT_ID, STERISH_AUDITOR_SECRET); nothing read them.

# --- contracts (from docs/deployments.md) -----------------------------------
REGISTRY_CA=C...
TOKENS_CA=C...
# Canonical escrow, wired to the real USDC SAC.
ESCROW_CA=C...
# Rehearsal escrow, wired to an asset we control. Used by the live integration
# tests when the canonical accounts hold no USDC: real testnet USDC comes only
# from the Circle faucet, which is web-only with a Captcha and cannot be scripted.
ESCROW_REHEARSAL_CA=C...

# --- network ----------------------------------------------------------------
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
HORIZON_URL=https://horizon-testnet.stellar.org

# --- signers (TESTNET ONLY — never reuse a mainnet key) ---------------------
# Each role signs a different call; they are not interchangeable:
#   DEVELOPER -> register_skill, create_audit_request (pays the fee)
#   AUDITOR   -> submit_verdict, mint_verified, post_bond (posts the bond)
#   DEPLOYER  -> settle, slash            (escrow admin)
DEVELOPER_ADDRESS=G...
DEVELOPER_SECRET=S...
AUDITOR_ADDRESS=G...
AUDITOR_SECRET=S...
DEPLOYER_ADDRESS=G...
DEPLOYER_SECRET=S...

# --- USDC (verified against the official docs and @x402/stellar) ------------
# Two different addresses; mixing them up is the common stumble.
#   classic issuer G... -> used when adding a trustline
#   SAC C...            -> the contract `transfer` is invoked on
USDC_CLASSIC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
USDC_SAC_ADDRESS=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA

# --- stage 3 LLM ------------------------------------------------------------
# Read from the environment only; never written to a config file or the verdict.
ANTHROPIC_API_KEY=
