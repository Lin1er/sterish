# Sterish audit pipeline — environment template.
#
#   cp pipeline/.env.example pipeline/.env
#
# `.env` is git-ignored. Never commit a real secret key. Only public keys (G...)
# and contract IDs (C...) are safe to share in tickets, PRs, or screenshots.

# --- Stellar network ---------------------------------------------------------
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# --- Deployed contracts ------------------------------------------------------
# Fill in after `make deploy-testnet`. Both are contract addresses (C...).
REGISTRY_CONTRACT_ID=
ESCROW_CONTRACT_ID=

# --- Auditor identity --------------------------------------------------------
# The account authorized to call submit_verdict on the registry.
# STERISH_AUDITOR_SECRET is a secret key (S...): keep it out of the repo, out of
# logs, and separate from the admin key.
STERISH_AUDITOR_PUBLIC=
STERISH_AUDITOR_SECRET=

# --- Report publication ------------------------------------------------------
# Where full audit reports are written, and the public base URL they end up at.
# evidence_hash on-chain == sha256 of the published report bytes.
STERISH_REPORT_DIR=./reports
STERISH_REPORT_BASE_URI=https://raw.githubusercontent.com/Lin1er/sterish/main/reports

# --- Sandbox (stage 2) -------------------------------------------------------
# Optional. Without Docker on PATH the pipeline falls back to static analysis.
STERISH_SANDBOX_IMAGE=sterish/sandbox:latest
STERISH_SANDBOX_TIMEOUT=30

# --- LLM stage (STERISH-10) --------------------------------------------------
# Only needed for the LLM-assisted description scanner. The deterministic audit
# path runs without any key, which is what CI and the corpus batch use.
ANTHROPIC_API_KEY=
STERISH_LLM_MODEL=claude-sonnet-5

# --- Logging -----------------------------------------------------------------
STERISH_LOG_LEVEL=INFO
