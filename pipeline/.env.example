# Sterish audit pipeline — example configuration.
# Copy to .env and fill in. NEVER commit a real .env (see .gitignore).

# --- contracts (from docs/deployments.md) -----------------------------------
REGISTRY_CA=C...
TOKENS_CA=C...
# Canonical escrow, wired to the real USDC SAC.
ESCROW_CA=C...
# Rehearsal escrow, wired to an asset we control. Used by the live integration
# tests because real testnet USDC comes only from the Circle faucet, which is
# web-only with a Captcha and cannot be scripted.
ESCROW_REHEARSAL_CA=C...

# --- network ----------------------------------------------------------------
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# --- signers (TESTNET ONLY — never reuse a mainnet key) ---------------------
# Each role signs a different call:
#   DEVELOPER  -> register_skill, create_audit_request
#   AUDITOR    -> submit_verdict, mint_verified, post_bond
#   DEPLOYER   -> settle, slash   (escrow admin)
DEVELOPER_ADDRESS=G...
DEVELOPER_SECRET=S...
AUDITOR_ADDRESS=G...
AUDITOR_SECRET=S...
DEPLOYER_ADDRESS=G...
DEPLOYER_SECRET=S...

# --- stage 3 LLM ------------------------------------------------------------
# Read from the environment only; never written to a config file or the verdict.
ANTHROPIC_API_KEY=
