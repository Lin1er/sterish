# Sterish Verification API — example configuration.
# Copy to .env and fill in. NEVER commit a real .env (see .gitignore).
# This service is read-only: it holds no keys and needs no funded account.

# --- required ---------------------------------------------------------------
# Registry contract deployed by STE-13 (docs/deployments.md). REGISTRY_CA is also
# accepted, which is the name the repo's root .env and deploy scripts already use.
REGISTRY_CONTRACT_ID=C...

# --- network ----------------------------------------------------------------
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# --- indexer ----------------------------------------------------------------
# The index only decorates chain answers with transaction links and backs /feed.
# Disabling it leaves verdicts correct; the tx links are then served as null.
INDEXER_ENABLED=1
INDEXER_POLL_SECONDS=8
# getEvents scans a bounded window forward from start_ledger, so the poller walks
# the history in chunks instead of asking for the whole retained range at once.
INDEXER_CHUNK_LEDGERS=4000
STERISH_DB_PATH=sterish_index.db

# --- serving ----------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=100
# Public base URL for the PLANNED /reports endpoint. Leave empty until reports are
# actually served: report_uri is advertised only when this is set, so clients are
# never handed a link that 404s.
REPORT_BASE_URL=

# --- x402 paid path (STE-19) ------------------------------------------------
# Tokens contract holding the VERIFIED badges and the licences.
TOKENS_CONTRACT_ID=C...
# OZ Channels facilitator. The testnet key generator needs no authentication:
#   curl https://channels.openzeppelin.com/testnet/gen
X402_FACILITATOR_URL=https://channels.openzeppelin.com/x402/testnet
OZ_API_KEY=
# Two different addresses; swapping them is the documented common stumble.
#   X402_PAY_TO   classic G... account that RECEIVES USDC (needs a USDC trustline)
#   USDC_SAC_ADDRESS  the C... contract `transfer` is invoked on
X402_PAY_TO=G...
USDC_SAC_ADDRESS=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
# Base units, 7 decimals: 1000000 = 0.10 USDC.
X402_PRICE_BASE_UNITS=1000000
# Signs mint_license. Must hold the tokens contract's minter role.
MINTER_SECRET=S...
# Where the pinned skill artifacts live: <dir>/<skill_id>/<version>/
# Bytes are re-hashed and checked against the chain before they are served.
STERISH_SKILLS_DIR=./artifacts
