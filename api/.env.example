# Sterish Verification API — environment template.
#
#   cp api/.env.example api/.env
#
# `.env` is git-ignored. Never commit a real secret key. Only public keys (G...)
# and contract IDs (C...) are safe to share in tickets, PRs, or screenshots.

# --- Stellar network ---------------------------------------------------------
# Soroban JSON-RPC endpoint the API reads the registry through.
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# --- Deployed contracts ------------------------------------------------------
# Fill in after `make deploy-testnet`. Both are contract addresses (C...).
# Leave empty to run the API in fixture mode (tests and local dev only).
REGISTRY_CONTRACT_ID=
ESCROW_CONTRACT_ID=

# Official USDC Stellar Asset Contract on testnet.
# This is a CONTRACT address (C...), not the classic issuer account (G...).
USDC_SAC_CONTRACT_ID=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA

# --- Read-only source account ------------------------------------------------
# Any funded testnet account; used only as the source of simulated (read-only)
# transactions. A public key is enough — no secret needed for reads.
STELLAR_READ_SOURCE_ACCOUNT=

# --- Indexer cache -----------------------------------------------------------
# The cache is a cache, not a source of truth: it can always be rebuilt from
# chain. SQLite by default; swap for a postgresql:// URL in production.
STERISH_CACHE_URL=sqlite:///./sterish-cache.db
STERISH_INDEXER_POLL_SECONDS=8

# --- x402 pay-per-use (STERISH-15) -------------------------------------------
# payTo MUST be a classic account address (G...) with a USDC trustline.
X402_PAY_TO_ACCOUNT=
X402_FACILITATOR_URL=
X402_DEFAULT_PRICE_USDC=0.1

# License minter. Secret key (S...) — server-side only, never commit.
LICENSE_MINTER_SECRET=

# --- Service -----------------------------------------------------------------
STERISH_API_HOST=0.0.0.0
STERISH_API_PORT=8000
STERISH_RATE_LIMIT_PER_MINUTE=100
STERISH_LOG_LEVEL=INFO
