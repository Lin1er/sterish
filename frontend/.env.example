# Copy to .env.local and edit. .env.local is gitignored; this file is tracked.
# Everything here is public: NEXT_PUBLIC_ values are inlined into the browser
# bundle, so no secret ever belongs in this file or in .env.local.

# Where the verification API lives. Must be absolute: these reads also run in
# server components, where a relative path has no origin to resolve against.
#
#   live testnet API   https://api-sterish.jameshub.fun
#   local API          http://localhost:8000
#   fixtures, no API   http://localhost:3000/api/mock
#
# The mock is served by this app itself and answers the read endpoints of
# docs/api-spec.md with the four verdict cases, including WARNING and
# UNAUDITED, which the live testnet registry does not currently hold.
NEXT_PUBLIC_API_URL=https://api-sterish.jameshub.fun

# Which Stellar network the wallet connects to, and which stellar.expert to
# link at. The STE-13 contracts are on testnet.
#   testnet | mainnet
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Soroban RPC for the dashboard's own chain reads: the USDC balance shown before
# a purchase, and the simulation @x402/stellar runs while building a payment.
# Optional on testnet, where it defaults to the public SDF endpoint. Required on
# mainnet, which has no public default.
# NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Horizon, for the testnet wallet setup guide (does the account exist, does it
# trust USDC). Defaults to the public SDF Horizon for the chosen network.
# NEXT_PUBLIC_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
