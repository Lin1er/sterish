# Read by pnpm (it honours .npmrc). `pnpm install --frozen-lockfile` is what CI
# and `make install-dashboard` use, so pnpm-lock.yaml is the source of truth.
save-exact=false
fund=false

# Next.js resolves its own plugins (SWC, eslint-config-next) through the package
# it was required from, so pnpm's default isolated store works. Nothing is
# hoisted on purpose: an undeclared import should fail here, not in production.
strict-peer-dependencies=false
